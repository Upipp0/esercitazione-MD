; ions.mdp - serve solo a costruire un .tpr per gmx genion.
; Con questo file non si esegue nessuna dinamica, quindi quasi tutto
; quello che c'e dentro e una formalita.
integrator      = steep
emtol           = 1000.0
emstep          = 0.01
nsteps          = 2000

cutoff-scheme   = Verlet
nstlist         = 10
coulombtype     = PME
rcoulomb        = 1.0
rvdw            = 1.0
pbc             = xyz
